# Server
APP_NAME=EduGuard-AI
APP_ENV=dev
SECRET_KEY=change-me-in-prod

# 首次部署引导（容器启动时自动执行；幂等）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# 设为 true 时，若数据库无任何培养方案则自动导入演示数据
# （25 名学生 / 3 个培养方案 / 97 门课程 / 24 条预警 / 通知与 AI 会话样例）
SEED_DEMO=true

# Database
DATABASE_URL=postgresql+psycopg://eduguard:eduguard@db:5432/eduguard

# LLM (OpenAI compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Notification - Email (SMTP)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Notification - WeCom / DingTalk
WECOM_ENABLED=false
WECOM_WEBHOOK=
DINGTALK_ENABLED=false
DINGTALK_WEBHOOK=

# Notification - SMS (Aliyun)
SMS_ENABLED=false
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
