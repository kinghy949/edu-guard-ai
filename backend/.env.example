# Server
APP_NAME=EduGuard-AI
# dev | prod；prod 模式下若 SECRET_KEY 仍为默认/弱值，服务将拒绝启动
APP_ENV=dev
# 生产环境必须替换：openssl rand -hex 32
SECRET_KEY=change-me-in-prod
# JWT 过期时间（分钟），默认 1440=24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 允许跨域访问的前端来源；逗号分隔或 JSON 数组
# 示例：CORS_ORIGINS=https://eduguard.example.edu.cn
# 示例：CORS_ORIGINS=["https://a.example.cn","https://b.example.cn"]
CORS_ORIGINS=http://localhost:5173
# 敏感配置（LLM api_key、SMTP 密码、webhook）加密密钥；生产必填
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# 登录失败 N 次后锁定，IP 每分钟最多 M 次登录请求；0 关闭
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_RATE_LIMIT=10

# 首次部署引导（容器启动时自动执行；幂等）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# 设为 true 时，若数据库无任何培养方案则自动导入演示数据
# （25 名学生 / 3 个培养方案 / 97 门课程 / 24 条预警 / 通知与 AI 会话样例）
SEED_DEMO=true

# Database
DATABASE_URL=postgresql+psycopg://eduguard:eduguard@db:5432/eduguard

# LLM (OpenAI compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Notification - Email (SMTP)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Notification - WeCom / DingTalk
WECOM_ENABLED=false
WECOM_WEBHOOK=
DINGTALK_ENABLED=false
DINGTALK_WEBHOOK=

# Notification - SMS (Aliyun)
SMS_ENABLED=false
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
