# Server
APP_NAME=EduGuard-AI
APP_ENV=dev
SECRET_KEY=change-me-in-prod

# Database
DATABASE_URL=postgresql+psycopg://eduguard:eduguard@db:5432/eduguard

# LLM (OpenAI compatible)
LLM_BASE_URL=https://api.openai.com/v1
